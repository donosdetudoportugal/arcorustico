import React, { useState, useEffect } from 'react';
import { Camera, Home, Users, Calendar, Package, Bed, UtensilsCrossed, Trash2, Plus, Clock, User, Upload, ChevronRight, Search, Filter, Edit2, Check, X } from 'lucide-react';

// Utility function for storage
const storage = window.storage;

const ArcoRusticoApp = () => {
  const [activeTab, setActiveTab] = useState('operator');
  const [operatorView, setOperatorView] = useState('items');
  const [clientView, setClientView] = useState('info');
  
  // Operator - House Items
  const [items, setItems] = useState([]);
  const [selectedCategory, setSelectedCategory] = useState('all');
  const [showAddItem, setShowAddItem] = useState(false);
  const [editingItem, setEditingItem] = useState(null);
  
  // Operator - Cleaning Schedule
  const [cleanings, setCleanings] = useState([]);
  const [showAddCleaning, setShowAddCleaning] = useState(false);
  const [editingCleaning, setEditingCleaning] = useState(null);
  
  // Client - Personal Data
  const [guests, setGuests] = useState([]);
  const [reservation, setReservation] = useState({ checkIn: '', checkOut: '' });
  const [showAddGuest, setShowAddGuest] = useState(false);
  const [editingGuest, setEditingGuest] = useState(null);
  
  const [loading, setLoading] = useState(true);
  const [searchTerm, setSearchTerm] = useState('');

  const categories = [
    { id: 'all', name: 'Todos', icon: Package },
    { id: 'kitchen', name: 'Cozinha', icon: UtensilsCrossed },
    { id: 'bedding', name: 'Roupas de Cama', icon: Bed },
    { id: 'decor', name: 'Decoração', icon: Home },
    { id: 'electronics', name: 'Eletrônicos', icon: Package },
    { id: 'outdoor', name: 'Área Externa', icon: Package },
    { id: 'bathroom', name: 'Casa de Banho', icon: Package },
    { id: 'laundry', name: 'Lavanderia', icon: Package }
  ];

  // Load data from storage
  useEffect(() => {
    loadAllData();
  }, []);

  const loadAllData = async () => {
    setLoading(true);
    try {
      // Load items
      const itemsData = await storage.get('house-items');
      if (itemsData?.value) {
        setItems(JSON.parse(itemsData.value));
      }
      
      // Load cleanings
      const cleaningsData = await storage.get('cleanings');
      if (cleaningsData?.value) {
        setCleanings(JSON.parse(cleaningsData.value));
      }
      
      // Load guests
      const guestsData = await storage.get('guests');
      if (guestsData?.value) {
        setGuests(JSON.parse(guestsData.value));
      }
      
      // Load reservation
      const reservationData = await storage.get('reservation');
      if (reservationData?.value) {
        setReservation(JSON.parse(reservationData.value));
      }
    } catch (error) {
      console.log('Loading initial data');
    }
    setLoading(false);
  };

  // Save functions
  const saveItems = async (newItems) => {
    try {
      await storage.set('house-items', JSON.stringify(newItems));
      setItems(newItems);
    } catch (error) {
      alert('Erro ao salvar itens. Tente novamente.');
    }
  };

  const saveCleanings = async (newCleanings) => {
    try {
      await storage.set('cleanings', JSON.stringify(newCleanings));
      setCleanings(newCleanings);
    } catch (error) {
      alert('Erro ao salvar limpezas. Tente novamente.');
    }
  };

  const saveGuests = async (newGuests) => {
    try {
      await storage.set('guests', JSON.stringify(newGuests));
      setGuests(newGuests);
    } catch (error) {
      alert('Erro ao salvar hóspedes. Tente novamente.');
    }
  };

  const saveReservation = async (newReservation) => {
    try {
      await storage.set('reservation', JSON.stringify(newReservation));
      setReservation(newReservation);
    } catch (error) {
      alert('Erro ao salvar reserva. Tente novamente.');
    }
  };

  // Image handling
  const handleImageUpload = (e, callback) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        callback(event.target.result);
      };
      reader.readAsDataURL(file);
    }
  };

  // Item Management
  const addItem = async (item) => {
    const newItem = {
      ...item,
      id: Date.now().toString(),
      createdAt: new Date().toISOString()
    };
    await saveItems([...items, newItem]);
    setShowAddItem(false);
  };

  const updateItem = async (id, updatedItem) => {
    await saveItems(items.map(item => item.id === id ? { ...item, ...updatedItem } : item));
    setEditingItem(null);
  };

  const deleteItem = async (id) => {
    if (confirm('Deseja realmente excluir este item?')) {
      await saveItems(items.filter(item => item.id !== id));
    }
  };

  // Cleaning Management
  const addCleaning = async (cleaning) => {
    const newCleaning = {
      ...cleaning,
      id: Date.now().toString(),
      createdAt: new Date().toISOString()
    };
    await saveCleanings([...cleanings, newCleaning]);
    setShowAddCleaning(false);
  };

  const updateCleaning = async (id, updatedCleaning) => {
    await saveCleanings(cleanings.map(c => c.id === id ? { ...c, ...updatedCleaning } : c));
    setEditingCleaning(null);
  };

  const deleteCleaning = async (id) => {
    if (confirm('Deseja realmente excluir este registro de limpeza?')) {
      await saveCleanings(cleanings.filter(c => c.id !== id));
    }
  };

  // Guest Management
  const addGuest = async (guest) => {
    if (guests.length >= 7) {
      alert('Limite máximo de 7 hóspedes atingido');
      return;
    }
    const newGuest = {
      ...guest,
      id: Date.now().toString(),
      createdAt: new Date().toISOString()
    };
    await saveGuests([...guests, newGuest]);
    setShowAddGuest(false);
  };

  const updateGuest = async (id, updatedGuest) => {
    await saveGuests(guests.map(g => g.id === id ? { ...g, ...updatedGuest } : g));
    setEditingGuest(null);
  };

  const deleteGuest = async (id) => {
    if (confirm('Deseja realmente remover este hóspede?')) {
      await saveGuests(guests.filter(g => g.id !== id));
    }
  };

  // Filter items
  const filteredItems = items.filter(item => {
    const matchesCategory = selectedCategory === 'all' || item.category === selectedCategory;
    const matchesSearch = item.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
                         item.description?.toLowerCase().includes(searchTerm.toLowerCase());
    return matchesCategory && matchesSearch;
  });

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-amber-50 via-orange-50 to-rose-50">
        <div className="text-center">
          <div className="w-16 h-16 border-4 border-amber-600 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
          <p className="text-amber-800 font-serif text-lg">Carregando...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-amber-50 via-orange-50 to-rose-50">
      {/* Background Image */}
      <div 
        className="fixed inset-0 opacity-10 bg-cover bg-center"
        style={{
          backgroundImage: 'url(/mnt/user-data/uploads/ARCO_RUSTICO_background_app.png)',
          filter: 'grayscale(20%)'
        }}
      />
      
      {/* Header */}
      <div className="relative z-10 bg-gradient-to-r from-amber-900 via-orange-800 to-amber-900 text-white shadow-2xl">
        <div className="max-w-7xl mx-auto px-4 py-6">
          <div className="flex items-center justify-between">
            <div>
              <h1 className="text-4xl font-serif font-bold tracking-wide">ARCO RÚSTICO</h1>
              <p className="text-amber-200 text-sm mt-1 tracking-widest uppercase">Retiro</p>
            </div>
            <Home className="w-12 h-12 opacity-60" />
          </div>
        </div>
      </div>

      {/* Main Navigation Tabs */}
      <div className="relative z-10 bg-white shadow-lg border-b-4 border-amber-600">
        <div className="max-w-7xl mx-auto px-4">
          <div className="flex gap-2">
            <button
              onClick={() => setActiveTab('operator')}
              className={`flex items-center gap-2 px-8 py-4 font-semibold transition-all border-b-4 ${
                activeTab === 'operator'
                  ? 'bg-amber-50 text-amber-900 border-amber-600'
                  : 'text-gray-600 border-transparent hover:bg-gray-50'
              }`}
            >
              <User className="w-5 h-5" />
              OPERADOR
            </button>
            <button
              onClick={() => setActiveTab('client')}
              className={`flex items-center gap-2 px-8 py-4 font-semibold transition-all border-b-4 ${
                activeTab === 'client'
                  ? 'bg-amber-50 text-amber-900 border-amber-600'
                  : 'text-gray-600 border-transparent hover:bg-gray-50'
              }`}
            >
              <Users className="w-5 h-5" />
              CLIENTES
            </button>
          </div>
        </div>
      </div>

      {/* Content */}
      <div className="relative z-10 max-w-7xl mx-auto px-4 py-8">
        {activeTab === 'operator' ? (
          <div>
            {/* Operator Sub-Navigation */}
            <div className="flex gap-4 mb-8">
              <button
                onClick={() => setOperatorView('items')}
                className={`flex items-center gap-2 px-6 py-3 rounded-lg font-semibold transition-all shadow-md ${
                  operatorView === 'items'
                    ? 'bg-amber-600 text-white'
                    : 'bg-white text-gray-700 hover:bg-amber-50'
                }`}
              >
                <Package className="w-5 h-5" />
                Itens da Casa
              </button>
              <button
                onClick={() => setOperatorView('cleaning')}
                className={`flex items-center gap-2 px-6 py-3 rounded-lg font-semibold transition-all shadow-md ${
                  operatorView === 'cleaning'
                    ? 'bg-amber-600 text-white'
                    : 'bg-white text-gray-700 hover:bg-amber-50'
                }`}
              >
                <Calendar className="w-5 h-5" />
                Controle de Limpeza
              </button>
            </div>

            {/* House Items View */}
            {operatorView === 'items' && (
              <div>
                {/* Controls */}
                <div className="bg-white rounded-xl shadow-lg p-6 mb-6">
                  <div className="flex flex-wrap gap-4 items-center justify-between mb-4">
                    <div className="flex-1 min-w-64">
                      <div className="relative">
                        <Search className="absolute left-3 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" />
                        <input
                          type="text"
                          placeholder="Buscar itens..."
                          value={searchTerm}
                          onChange={(e) => setSearchTerm(e.target.value)}
                          className="w-full pl-10 pr-4 py-3 border-2 border-gray-300 rounded-lg focus:border-amber-500 focus:outline-none"
                        />
                      </div>
                    </div>
                    <button
                      onClick={() => setShowAddItem(true)}
                      className="flex items-center gap-2 px-6 py-3 bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition-all shadow-md"
                    >
                      <Plus className="w-5 h-5" />
                      Adicionar Item
                    </button>
                  </div>

                  {/* Category Filter */}
                  <div className="flex flex-wrap gap-2">
                    {categories.map(cat => {
                      const Icon = cat.icon;
                      return (
                        <button
                          key={cat.id}
                          onClick={() => setSelectedCategory(cat.id)}
                          className={`flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-all ${
                            selectedCategory === cat.id
                              ? 'bg-amber-600 text-white shadow-md'
                              : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
                          }`}
                        >
                          <Icon className="w-4 h-4" />
                          {cat.name}
                        </button>
                      );
                    })}
                  </div>
                </div>

                {/* Items Grid */}
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {filteredItems.map(item => (
                    <div key={item.id} className="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all">
                      {item.image && (
                        <div className="h-48 bg-gradient-to-br from-amber-100 to-orange-100">
                          <img src={item.image} alt={item.name} className="w-full h-full object-cover" />
                        </div>
                      )}
                      <div className="p-5">
                        <div className="flex items-start justify-between mb-3">
                          <div className="flex-1">
                            <h3 className="font-bold text-lg text-gray-900">{item.name}</h3>
                            <span className="inline-block mt-1 px-3 py-1 bg-amber-100 text-amber-800 text-xs rounded-full font-medium">
                              {categories.find(c => c.id === item.category)?.name}
                            </span>
                          </div>
                        </div>
                        {item.description && (
                          <p className="text-gray-600 text-sm mb-4">{item.description}</p>
                        )}
                        {item.quantity && (
                          <p className="text-sm text-gray-500 mb-4">Quantidade: <span className="font-semibold">{item.quantity}</span></p>
                        )}
                        <div className="flex gap-2">
                          <button
                            onClick={() => setEditingItem(item)}
                            className="flex-1 flex items-center justify-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all"
                          >
                            <Edit2 className="w-4 h-4" />
                            Editar
                          </button>
                          <button
                            onClick={() => deleteItem(item.id)}
                            className="flex items-center justify-center gap-2 px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-all"
                          >
                            <Trash2 className="w-4 h-4" />
                          </button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                {filteredItems.length === 0 && (
                  <div className="bg-white rounded-xl shadow-lg p-12 text-center">
                    <Package className="w-16 h-16 text-gray-300 mx-auto mb-4" />
                    <p className="text-gray-500 text-lg">Nenhum item encontrado</p>
                  </div>
                )}
              </div>
            )}

            {/* Cleaning Schedule View */}
            {operatorView === 'cleaning' && (
              <div>
                <div className="bg-white rounded-xl shadow-lg p-6 mb-6">
                  <button
                    onClick={() => setShowAddCleaning(true)}
                    className="flex items-center gap-2 px-6 py-3 bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition-all shadow-md"
                  >
                    <Plus className="w-5 h-5" />
                    Registrar Limpeza
                  </button>
                </div>

                <div className="space-y-4">
                  {cleanings.sort((a, b) => new Date(b.date) - new Date(a.date)).map(cleaning => (
                    <div key={cleaning.id} className="bg-white rounded-xl shadow-lg p-6 hover:shadow-2xl transition-all">
                      <div className="flex items-start justify-between">
                        <div className="flex-1">
                          <div className="flex items-center gap-3 mb-3">
                            <Calendar className="w-6 h-6 text-amber-600" />
                            <h3 className="font-bold text-xl text-gray-900">
                              {new Date(cleaning.date).toLocaleDateString('pt-BR')}
                            </h3>
                          </div>
                          <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                            <div className="flex items-center gap-2">
                              <Clock className="w-5 h-5 text-gray-400" />
                              <div>
                                <p className="text-xs text-gray-500">Entrada</p>
                                <p className="font-semibold text-gray-900">{cleaning.checkIn}</p>
                              </div>
                            </div>
                            <div className="flex items-center gap-2">
                              <Clock className="w-5 h-5 text-gray-400" />
                              <div>
                                <p className="text-xs text-gray-500">Saída</p>
                                <p className="font-semibold text-gray-900">{cleaning.checkOut}</p>
                              </div>
                            </div>
                            <div className="flex items-center gap-2">
                              <User className="w-5 h-5 text-gray-400" />
                              <div>
                                <p className="text-xs text-gray-500">Responsável</p>
                                <p className="font-semibold text-gray-900">{cleaning.responsible}</p>
                              </div>
                            </div>
                          </div>
                          {cleaning.notes && (
                            <div className="bg-amber-50 border-l-4 border-amber-600 p-4 rounded">
                              <p className="text-sm text-gray-700">{cleaning.notes}</p>
                            </div>
                          )}
                        </div>
                        <div className="flex gap-2 ml-4">
                          <button
                            onClick={() => setEditingCleaning(cleaning)}
                            className="p-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all"
                          >
                            <Edit2 className="w-5 h-5" />
                          </button>
                          <button
                            onClick={() => deleteCleaning(cleaning.id)}
                            className="p-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-all"
                          >
                            <Trash2 className="w-5 h-5" />
                          </button>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                {cleanings.length === 0 && (
                  <div className="bg-white rounded-xl shadow-lg p-12 text-center">
                    <Calendar className="w-16 h-16 text-gray-300 mx-auto mb-4" />
                    <p className="text-gray-500 text-lg">Nenhum registro de limpeza</p>
                  </div>
                )}
              </div>
            )}
          </div>
        ) : (
          // Client View
          <div>
            {/* Reservation Dates */}
            <div className="bg-white rounded-xl shadow-lg p-6 mb-6">
              <h2 className="text-2xl font-bold text-gray-900 mb-4 flex items-center gap-2">
                <Calendar className="w-6 h-6 text-amber-600" />
                Dados da Reserva
              </h2>
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label className="block text-sm font-semibold text-gray-700 mb-2">Data de Entrada</label>
                  <input
                    type="date"
                    value={reservation.checkIn}
                    onChange={(e) => saveReservation({ ...reservation, checkIn: e.target.value })}
                    className="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-amber-500 focus:outline-none"
                  />
                </div>
                <div>
                  <label className="block text-sm font-semibold text-gray-700 mb-2">Data de Saída</label>
                  <input
                    type="date"
                    value={reservation.checkOut}
                    onChange={(e) => saveReservation({ ...reservation, checkOut: e.target.value })}
                    className="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:border-amber-500 focus:outline-none"
                  />
                </div>
              </div>
            </div>

            {/* Guests */}
            <div className="bg-white rounded-xl shadow-lg p-6">
              <div className="flex items-center justify-between mb-6">
                <h2 className="text-2xl font-bold text-gray-900 flex items-center gap-2">
                  <Users className="w-6 h-6 text-amber-600" />
                  Hóspedes ({guests.length}/7)
                </h2>
                {guests.length < 7 && (
                  <button
                    onClick={() => setShowAddGuest(true)}
                    className="flex items-center gap-2 px-6 py-3 bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 transition-all shadow-md"
                  >
                    <Plus className="w-5 h-5" />
                    Adicionar Hóspede
                  </button>
                )}
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                {guests.map((guest, index) => (
                  <div key={guest.id} className="border-2 border-gray-200 rounded-xl p-5 hover:border-amber-500 transition-all">
                    <div className="flex items-start justify-between mb-4">
                      <div className="flex items-center gap-3">
                        <div className="w-12 h-12 bg-amber-600 text-white rounded-full flex items-center justify-center font-bold text-lg">
                          {index + 1}
                        </div>
                        <div>
                          <h3 className="font-bold text-lg text-gray-900">{guest.name}</h3>
                          <p className="text-sm text-gray-500">{guest.document}</p>
                        </div>
                      </div>
                      <div className="flex gap-2">
                        <button
                          onClick={() => setEditingGuest(guest)}
                          className="p-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all"
                        >
                          <Edit2 className="w-4 h-4" />
                        </button>
                        <button
                          onClick={() => deleteGuest(guest.id)}
                          className="p-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-all"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>
                    </div>
                    <div className="space-y-2 text-sm">
                      <p className="text-gray-600"><span className="font-semibold">Email:</span> {guest.email}</p>
                      <p className="text-gray-600"><span className="font-semibold">Telefone:</span> {guest.phone}</p>
                      {guest.documentImage && (
                        <div className="mt-3">
                          <p className="text-xs text-gray-500 mb-2">Documento:</p>
                          <img src={guest.documentImage} alt="Documento" className="w-full h-32 object-cover rounded-lg border-2 border-gray-200" />
                        </div>
                      )}
                    </div>
                  </div>
                ))}
              </div>

              {guests.length === 0 && (
                <div className="text-center py-12">
                  <Users className="w-16 h-16 text-gray-300 mx-auto mb-4" />
                  <p className="text-gray-500 text-lg">Nenhum hóspede cadastrado</p>
                </div>
              )}
            </div>
          </div>
        )}
      </div>

      {/* Modals */}
      <ItemFormModal 
        show={showAddItem || editingItem}
        item={editingItem}
        onClose={() => {
          setShowAddItem(false);
          setEditingItem(null);
        }}
        onSave={(item) => editingItem ? updateItem(editingItem.id, item) : addItem(item)}
        onImageUpload={handleImageUpload}
        categories={categories}
      />

      <CleaningFormModal
        show={showAddCleaning || editingCleaning}
        cleaning={editingCleaning}
        onClose={() => {
          setShowAddCleaning(false);
          setEditingCleaning(null);
        }}
        onSave={(cleaning) => editingCleaning ? updateCleaning(editingCleaning.id, cleaning) : addCleaning(cleaning)}
      />

      <GuestFormModal
        show={showAddGuest || editingGuest}
        guest={editingGuest}
        onClose={() => {
          setShowAddGuest(false);
          setEditingGuest(null);
        }}
        onSave={(guest) => editingGuest ? updateGuest(editingGuest.id, guest) : addGuest(guest)}
        onImageUpload={handleImageUpload}
      />
    </div>
  );
};

// Item Form Modal
const ItemFormModal = ({ show, item, onClose, onSave, onImageUpload, categories }) => {
  const [formData, setFormData] = useState({
    name: '',
    category: 'kitchen',
    description: '',
    quantity: '',
    image: ''
  });

  useEffect(() => {
    if (item) {
      setFormData(item);
    } else {
      setFormData({
        name: '',
        category: 'kitchen',
        description: '',
        quantity: '',
        image: ''
      });
    }
  }, [item, show]);

  if (!show) return null;

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!formData.name.trim()) {
      alert('Por favor, preencha o nome do item');
      return;
    }
    onSave(formData);
  };

  return (
    <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50" onClick={onClose}>
      <div className="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto" onClick={(e) => e.stopPropagation()}>
        <div className="bg-gradient-to-r from-amber-600 to-orange-600 text-white p-6 rounded-t-2xl">
          <h2 className="text-2xl font-bold">{item ? 'Editar Item' : 'Adicionar Item'}</h2>
        </div>
        <form onSubmit={handleSubmit} className="p-6 space-y-4">
          <div>
